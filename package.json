{
  "name": "@arkade-os/wdk",
  "version": "0.1.3",
  "description": "WDK (Wallet Development Kit) implementation using the Arkade Bitcoin SDK",
  "main": "src/index.js",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test src/__tests__/*.test.js",
    "test:watch": "node --test --watch src/__tests__/*.test.js",
    "test:e2e": "node --experimental-eventsource --test test/e2e/*.test.js",
    "test:e2e:sample": "node --experimental-eventsource test/e2e/sample-service.mjs",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "build:types": "node scripts/build-types.js",
    "prepublishOnly": "npm run build:types",
    "lint": "eslint src --ext .js && npm run typecheck",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "setup:dev": "node scripts/setup-dev.js",
    "release": "node scripts/release.js"
  },
  "keywords": [
    "bitcoin",
    "ark",
    "wallet",
    "wdk",
    "arkade",
    "cryptocurrency",
    "blockchain"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@arkade-os/lnurl-client": "0.9.4",
    "@arkade-os/sdk": "0.5.6",
    "@arkade-os/swap": "0.1.6",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@tetherto/wdk-wallet": "1.0.0-beta.26",
    "nostr-tools": "2.24.1",
    "sodium-universal": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tetherto/wdk": "1.0.0-beta.23",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "^3.2.4",
    "typescript": "7.0.2"
  },
  "files": [
    "src",
    "types",
    "!src/__tests__"
  ],
  "engines": {
    "node": ">=22.13.0 <27"
  }
}
