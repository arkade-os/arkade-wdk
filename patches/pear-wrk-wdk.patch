diff --git a/test/hrpc-compat.test.cjs b/test/hrpc-compat.test.cjs
new file mode 100644
index 0000000..ce7e553
--- /dev/null
+++ b/test/hrpc-compat.test.cjs
@@ -0,0 +1,235 @@
+const { test } = require('node:test')
+const assert = require('node:assert/strict')
+const fs = require('node:fs')
+const path = require('node:path')
+const { Duplex } = require('node:stream')
+const { RPC, c } = require('hrpc/runtime')
+const HRPC = require('../spec/hrpc')
+const { getEncoding } = require('../spec/hrpc/messages')
+
+test('preserves existing RPC slots and dispatches old and new clients', { timeout: 5000 }, async () => {
+  const root = path.join(__dirname, '..')
+  const definition = JSON.parse(fs.readFileSync(path.join(root, 'spec/hrpc/hrpc.json')))
+  const bindings = fs.readFileSync(path.join(root, 'spec/hrpc/index.js'), 'utf8')
+  for (const [index, entry] of definition.schema.entries()) assert.equal(entry.id, index)
+  const expected = [
+    [20, 'arkadeGetLightningLimits'], [21, 'arkadeGetLightningFees'],
+    [22, 'arkadeGetTransactionHistory'], [23, 'arkadeWaitForLightningPayment'],
+    [24, 'arkadeGetSwapMarkets'], [25, 'workletStop']
+  ]
+  for (const [id, name] of expected) {
+    assert.equal(definition.schema.find(entry => entry.id === id).name, `@wdk-core/${name}`)
+    assert.ok(bindings.includes(`['@wdk-core/${name}', ${id}]`))
+    assert.ok(bindings.includes(`[${id}, '@wdk-core/${name}']`))
+  }
+  const clientStream = new Duplex({
+    read () {},
+    write (chunk, _encoding, callback) { serverStream.push(chunk); callback() }
+  })
+  const serverStream = new Duplex({
+    read () {},
+    write (chunk, _encoding, callback) { clientStream.push(chunk); callback() }
+  })
+  const server = new HRPC(serverStream)
+  const oldClient = new RPC(clientStream)
+  let historyCalls = 0
+  let marketsCalls = 0
+  server.onArkadeGetTransactionHistory(async () => {
+    historyCalls++
+    return { transactions: '[{"txid":"history"}]' }
+  })
+  server.onArkadeGetSwapMarkets(async () => {
+    marketsCalls++
+    return { markets: '[{"key":"new-market"}]' }
+  })
+  for (const name of ['LightningLimits', 'LightningFees', 'WaitForLightningPayment']) {
+    const method = name.startsWith('Wait') ? `onArkade${name}` : `onArkadeGet${name}`
+    server[method](async () => { throw new Error('This retired RPC is no longer supported') })
+  }
+  async function call(id, name, args) {
+    const request = oldClient.request(id)
+    request.send(c.encode(getEncoding(`@wdk-core/${name}-request`), args))
+    return c.decode(getEncoding(`@wdk-core/${name}-response`), await request.reply())
+  }
+  try {
+    assert.deepEqual(await call(22, 'arkadeGetTransactionHistory', { accountIndex: 0 }), {
+      transactions: '[{"txid":"history"}]'
+    })
+    assert.deepEqual(await call(24, 'arkadeGetSwapMarkets', { accountIndex: 0 }), {
+      markets: '[{"key":"new-market"}]'
+    })
+    for (const [id, name] of expected.filter(([id]) => [20, 21, 23].includes(id))) {
+      await assert.rejects(call(id, name, { accountIndex: 0, invoice: 'ln-old' }), /retired RPC/)
+    }
+    assert.equal(historyCalls, 1)
+    assert.equal(marketsCalls, 1)
+  } finally {
+    clientStream.destroy()
+    serverStream.destroy()
+  }
+})
+
+test('manager drains every cached wallet before clearing secrets', async () => {
+  const { WdkManager } = require('../src/wdk-core/wdk-manager')
+  const manager = new WdkManager('seed', {})
+  let finishWallet
+  let finishAbstracted
+  let walletStarted
+  let abstractedStarted
+  const walletGate = new Promise(resolve => { finishWallet = resolve })
+  const abstractedGate = new Promise(resolve => { finishAbstracted = resolve })
+  const walletEntered = new Promise(resolve => { walletStarted = resolve })
+  const abstractedEntered = new Promise(resolve => { abstractedStarted = resolve })
+  manager._wallets = { arkade: { dispose: async () => { walletStarted(); await walletGate } } }
+  manager._account_abstraction_wallets = { ethereum: { dispose: async () => { abstractedStarted(); await abstractedGate } } }
+  const disposed = manager.dispose()
+  assert.equal(manager.dispose(), disposed)
+  await Promise.all([walletEntered, abstractedEntered])
+  assert.equal(manager._seed, 'seed')
+  await assert.rejects(manager._getWalletManager('arkade'), /disposed/)
+  finishWallet()
+  await new Promise(resolve => setImmediate(resolve))
+  assert.equal(manager._seed, 'seed')
+  finishAbstracted()
+  await disposed
+  assert.equal(manager._seed, null)
+  assert.equal(manager._config, null)
+  assert.deepEqual(manager._wallets, {})
+  assert.deepEqual(manager._account_abstraction_wallets, {})
+})
+
+test('worklet stop and restart acknowledge only after wallet teardown', { timeout: 5000 }, async () => {
+  const instances = []
+  class Manager {
+    constructor () { instances.push(this) }
+    async dispose () { if (this.entered) this.entered(); await this.gate }
+  }
+  const { client, close } = workletClient(Manager)
+  const start = () => client.workletStart({ seedPhrase: 'seed', config: '{}' })
+  try {
+    assert.equal((await start()).status, 'started')
+    let finish
+    let entered
+    const draining = new Promise(resolve => { entered = resolve })
+    instances[0].gate = new Promise(resolve => { finish = resolve })
+    instances[0].entered = entered
+    let acknowledged = false
+    const stopping = client.workletStop({}).then(value => { acknowledged = true; return value })
+    await draining
+    assert.equal(acknowledged, false)
+    finish()
+    assert.equal((await stopping).status, 'stopped')
+    assert.equal((await client.workletStop({})).status, 'stopped')
+    assert.equal((await start()).status, 'started')
+    let finishRestart
+    let restartEntered
+    const restarting = new Promise(resolve => { restartEntered = resolve })
+    instances[1].gate = new Promise(resolve => { finishRestart = resolve })
+    instances[1].entered = restartEntered
+    const restarted = start()
+    await restarting
+    assert.equal(instances.length, 2)
+    finishRestart()
+    assert.equal((await restarted).status, 'started')
+    assert.equal(instances.length, 3)
+    await client.workletStop({})
+  } finally {
+    close()
+  }
+})
+
+test('serializes concurrent starts and stops without abandoning a wallet', { timeout: 5000 }, async () => {
+  const instances = []
+  class Manager {
+    constructor () { this.disposed = false; instances.push(this) }
+    async dispose () {
+      if (this.entered) this.entered()
+      await this.gate
+      this.disposed = true
+    }
+  }
+  const { client, close } = workletClient(Manager)
+  const start = () => client.workletStart({ seedPhrase: 'seed', config: '{}' })
+  try {
+    for (const command of ['stop', 'start']) {
+      await start()
+      const previous = instances.at(-1)
+      let finish
+      let entered
+      const draining = new Promise(resolve => { entered = resolve })
+      previous.gate = new Promise(resolve => { finish = resolve })
+      previous.entered = entered
+      const starting = start()
+      const competing = command === 'stop' ? client.workletStop({}) : start()
+      await draining
+      finish()
+      await Promise.all([starting, competing])
+      await client.workletStop({})
+      assert.ok(instances.every(manager => manager.disposed), `${command} abandoned a wallet`)
+    }
+    await assert.rejects(client.workletStart({ seedPhrase: 'seed', config: '{' }))
+    assert.equal((await start()).status, 'started')
+    await client.workletStop({})
+  } finally {
+    close()
+  }
+})
+
+test('a rejected teardown does not retain a terminal manager', { timeout: 5000 }, async () => {
+  for (const command of ['workletStop', 'dispose', 'workletStart']) {
+    const instances = []
+    class Manager {
+      constructor () { instances.push(this) }
+      async dispose () { if (this.fail) throw new Error('teardown failed') }
+    }
+    const { client, close, errors } = workletClient(Manager)
+    const start = () => client.workletStart({ seedPhrase: 'seed', config: '{}' })
+    try {
+      await start()
+      instances[0].fail = true
+      if (command === 'dispose') client.dispose({})
+      else await assert.rejects(command === 'workletStart' ? start() : client[command]({}), /teardown failed/)
+      assert.equal((await start()).status, 'started', command)
+      if (command === 'dispose') assert.match(errors[0], /teardown failed/)
+      assert.equal(instances.length, 2)
+      await client.workletStop({})
+    } finally {
+      close()
+    }
+  }
+})
+
+test('starts and stops over modern Bare IPC', { timeout: 5000 }, async () => {
+  let disposed = false
+  class Manager {
+    async dispose () { disposed = true }
+  }
+  const { client, close } = workletClient(Manager, 'Bare')
+  try {
+    assert.equal((await client.workletStart({ seedPhrase: 'seed', config: '{}' })).status, 'started')
+    assert.equal((await client.workletStop({})).status, 'stopped')
+    assert.equal(disposed, true)
+  } finally {
+    close()
+  }
+})
+
+function workletClient (Manager, runtime = 'BareKit') {
+  const vm = require('node:vm')
+  const { createRequire } = require('node:module')
+  const file = path.join(__dirname, '../src/wdk-worklet.js')
+  const nativeRequire = createRequire(file)
+  const errors = []
+  const clientStream = new Duplex({ read () {}, write (chunk, _encoding, callback) { serverStream.push(chunk); callback() } })
+  const serverStream = new Duplex({ read () {}, write (chunk, _encoding, callback) { clientStream.push(chunk); callback() } })
+  vm.runInNewContext(fs.readFileSync(file, 'utf8'), {
+    [runtime]: { IPC: serverStream },
+    console: { error: error => errors.push(error) },
+    require: name => name.endsWith('/wdk-manager') ? { WdkManager: Manager } : nativeRequire(name)
+  }, { filename: file })
+  return {
+    errors,
+    client: new HRPC(clientStream),
+    close () { clientStream.destroy(); serverStream.destroy() }
+  }
+}
