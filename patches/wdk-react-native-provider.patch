+    instance.config = { chains: { arkade: { arkServerUrl: 'http://regtest.invalid' } } };
+    await instance.initArkadeWallet(seed);
+    assert.ok(instance.arkadeManager);
+    const config = configs.at(-1);
+    return typeof config.storage === 'function' ? config.storage(accountPath) : config.storage;
+  }
+  try {
+    const executor = {
+      run: async (sql, params = []) => { db.prepare(sql).run(...params); },
+      get: async (sql, params = []) => db.prepare(sql).get(...params),
+      all: async (sql, params = []) => db.prepare(sql).all(...params),
+    };
+    const legacy = new sqlite.SQLiteWalletRepository(executor);
+    await legacy.saveWalletState({ settings: { marker: 'legacy' } });
+    const first = await open('seed one');
+    assert.equal(await first.walletRepository.getWalletState(), null);
+    await first.walletRepository.saveWalletState({ settings: { marker: 'first wallet' } });
+    await first.contractRepository.saveContract({ script: 'aa', address: 'old-address', type: 'default', params: {}, state: 'active', createdAt: 1 });
+    await first.intentRepository.saveBatchRegistration({ proofTxId: 'old-proof', state: 'cancelled', createdAt: 1, updatedAt: 1, registerProof: '', registerProofMessage: '', deleteProof: '', deleteProofMessage: '', partialForfeits: [], proofInputs: [] });
+    const otherPath = await open('seed one', "m/86'/1/0'/0/1");
+    assert.equal(await otherPath.walletRepository.getWalletState(), null);
+    assert.deepEqual((await otherPath.contractRepository.getContractsPage(undefined, { limit: 10 })).items, []);
+    db.close(); db = new DatabaseSync(dbPath);
+    const second = await open('seed two');
+    assert.equal(await second.walletRepository.getWalletState(), null);
+    assert.deepEqual((await second.contractRepository.getContractsPage(undefined, { limit: 10 })).items, []);
+    assert.deepEqual((await second.intentRepository.getBatchRegistrationsPage(undefined, { limit: 10 })).items, []);
+    await second.walletRepository.saveWalletState({ settings: { marker: 'second wallet' } });
+    db.close(); db = new DatabaseSync(dbPath);
+    const restored = await open('seed one');
+    assert.equal((await restored.walletRepository.getWalletState()).settings.marker, 'first wallet');
+    assert.equal((await restored.contractRepository.getContractsPage(undefined, { limit: 10 })).items[0].script, 'aa');
+    assert.equal((await restored.intentRepository.getBatchRegistrationsPage(undefined, { limit: 10 })).items[0].proofTxId, 'old-proof');
+    assert.equal((await legacy.getWalletState()).settings.marker, 'legacy');
+  } finally { db.close(); }
+});
diff --git a/test/arkade-startup.test.cjs b/test/arkade-startup.test.cjs
new file mode 100644
index 0000000..4c64c1c
--- /dev/null
+++ b/test/arkade-startup.test.cjs
@@ -0,0 +1,153 @@
+const fs = require('node:fs');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const ts = require('typescript');
+
+const tick = () => new Promise(resolve => setImmediate(resolve));
+const storedWallet = { name: 'Restored wallet', enabledAssets: [] };
+
+function deferred() {
+  let resolve;
+  const promise = new Promise(finish => { resolve = finish; });
+  return { promise, resolve };
+}
+
+function provider({ stored, initialized = Promise.resolve() }) {
+  const slots = [];
+  const effects = [];
+  let cursor = 0;
+  let pending = [];
+  let createCalls = 0;
+  const react = {
+    createContext: () => ({ Provider: 'WalletContext' }),
+    useState(initial) {
+      const index = cursor++;
+      if (!(index in slots)) slots[index] = initial;
+      return [slots[index], value => { slots[index] = value; }];
+    },
+    useReducer(reducer, initial) {
+      const index = cursor++;
+      slots[index] ??= initial;
+      return [slots[index], action => { slots[index] = reducer(slots[index], action); }];
+    },
+    useEffect(effect, deps) {
+      const index = cursor++;
+      const previous = effects[index]?.deps;
+      if (!previous || !deps || deps.some((value, i) => !Object.is(value, previous[i]))) {
+        pending.push({ index, effect, deps });
+      }
+    },
+  };
+  const storage = {
+    getItem: key => key === 'wdk_wallet_data' ? stored : Promise.resolve(null),
+    setItem: async () => {},
+  };
+  const service = {
+    setConfig() {},
+    initialize: () => initialized,
+    onArkadeBalanceChange: () => () => {},
+    createWallet: async () => { createCalls++; return storedWallet; },
+    resolveWalletAddresses: async () => ({}),
+  };
+  const mocks = {
+    react,
+    'react/jsx-runtime': { jsx: (type, props) => ({ type, props }) },
+    '@react-native-async-storage/async-storage': storage,
+    '../services/wdk-service': { WDKService: service },
+    'react-native-device-info': { getUniqueId: async () => 'device' },
+    '../utils/get-balances-from-balance-map': value => value,
+    '../utils/get-transactions-from-transaction-map': value => value,
+  };
+  function load(relative) {
+    const file = path.join(__dirname, '../src/contexts', relative);
+    const code = ts.transpileModule(fs.readFileSync(file, 'utf8'), {
+      compilerOptions: {
+        module: ts.ModuleKind.CommonJS,
+        jsx: ts.JsxEmit.ReactJSX,
+        esModuleInterop: true,
+      },
+    }).outputText;
+    const exported = {};
+    new Function('exports', 'require', code)(exported, name => {
+      assert.ok(name in mocks, `Unexpected context dependency: ${name}`);
+      return mocks[name];
+    });
+    return exported;
+  }
+  mocks['./constants'] = load('constants.ts');
+  mocks['./reducer'] = load('reducer.ts');
+  const { WalletProvider } = load('wallet-context.tsx');
+  const config = { indexer: {} };
+  return {
+    render() {
+      cursor = 0;
+      pending = [];
+      const tree = WalletProvider({ children: null, config });
+      for (const { index, effect, deps } of pending) {
+        effects[index]?.cleanup?.();
+        effects[index] = { deps, cleanup: effect() };
+      }
+      return tree.props.value;
+    },
+    get createCalls() { return createCalls; },
+    unmount() { for (const effect of effects) effect?.cleanup?.(); },
+  };
+}
+
+test('startup waits for stored wallet hydration after the SDK initializes', async () => {
+  const storage = deferred();
+  const view = provider({ stored: storage.promise });
+  try {
+    view.render();
+    await tick();
+    assert.equal(view.render().isInitialized, false);
+    storage.resolve(JSON.stringify(storedWallet));
+    await tick();
+    const state = view.render();
+    assert.equal(state.isInitialized, true);
+    assert.deepEqual(state.wallet, storedWallet);
+    assert.equal(state.isUnlocked, false);
+  } finally { view.unmount(); }
+});
+
+test('hydrated metadata does not bypass pending SDK initialization', async () => {
+  const initialization = deferred();
+  const view = provider({ stored: Promise.resolve(JSON.stringify(storedWallet)), initialized: initialization.promise });
+  try {
+    view.render();
+    await tick();
+    const restoring = view.render();
+    assert.deepEqual(restoring.wallet, storedWallet);
+    assert.equal(restoring.isInitialized, false);
+    initialization.resolve();
+    await tick();
+    assert.equal(view.render().isInitialized, true);
+  } finally { view.unmount(); }
+});
+
+test('a fresh installation becomes ready only after confirming no stored wallet', async () => {
+  const storage = deferred();
+  const view = provider({ stored: storage.promise });
+  try {
+    view.render();
+    await tick();
+    assert.equal(view.render().isInitialized, false);
+    storage.resolve(null);
+    await tick();
+    const state = view.render();
+    assert.equal(state.isInitialized, true);
+    assert.equal(state.wallet, null);
+  } finally { view.unmount(); }
+});
+
+test('wallet creation cannot overwrite metadata before hydration completes', async () => {
+  const storage = deferred();
+  const view = provider({ stored: storage.promise });
+  try {
+    view.render();
+    await tick();
+    await assert.rejects(view.render().createWallet({ name: 'New wallet' }), /not initialized/);
+    assert.equal(view.createCalls, 0);
+  } finally { storage.resolve(null); await tick(); view.unmount(); }
+});
diff --git a/test/worklet-bridge.test.cjs b/test/worklet-bridge.test.cjs
new file mode 100644
index 0000000..9068c98
--- /dev/null
+++ b/test/worklet-bridge.test.cjs
@@ -0,0 +1,32 @@
+const { readFileSync } = require('node:fs');
+const { createRequire } = require('node:module');
+const path = require('node:path');
+const { Duplex } = require('node:stream');
+const vm = require('node:vm');
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+
+for (const namespace of ['BareKit', 'Bare']) {
+  test(`secret-manager starts over real HRPC with ${namespace}.IPC`, { timeout: 5000 }, async () => {
+    const file = path.join(__dirname, '../src/worklet/wdk-secret-manager-worklet.js');
+    const workerRequire = createRequire(file);
+    const clientStream = new Duplex({ read() {}, write(chunk, _encoding, done) { serverStream.push(chunk); done(); } });
+    const serverStream = new Duplex({ read() {}, write(chunk, _encoding, done) { clientStream.push(chunk); done(); } });
+    try {
+      vm.runInNewContext(readFileSync(file, 'utf8'), {
+        require: name => name === '@tetherto/wdk-secret-manager'
+          ? { WdkSecretManager: class { constructor() { throw new Error('Handshake must not access secrets'); } } }
+          : workerRequire(name),
+        [namespace]: { IPC: serverStream },
+        console: { error() {}, warn() {}, info() {}, debug() {}, log() {} },
+      }, { filename: file });
+      const HRPC = workerRequire('../spec/hrpc');
+      const client = new HRPC(clientStream);
+      const response = await client.commandWorkletStart({ enableDebugLogs: 0 });
+      assert.equal(response.status, 'started');
+    } finally {
+      clientStream.destroy();
+      serverStream.destroy();
+    }
+  });
+}
diff --git a/test/worklet-bundles.test.cjs b/test/worklet-bundles.test.cjs
new file mode 100644
index 0000000..e9c1a2f
--- /dev/null
+++ b/test/worklet-bundles.test.cjs
@@ -0,0 +1,25 @@
+const { readFileSync } = require('node:fs');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+
+for (const name of ['wdk-secret-manager-worklet.bundle.js', 'wdk-worklet.mobile.bundle.js']) {
+  test(`${name} resolves complete native modules without legacy shims`, () => {
+    const file = path.join(__dirname, '../lib/module/services/wdk-service', name);
+    const source = readFileSync(file, 'utf8');
+    assert.ok(source.startsWith('module.exports = '));
+    const bundle = JSON.parse(source.slice('module.exports = '.length).trim().replace(/;$/, ''));
+    const firstLine = bundle.indexOf('\n');
+    const manifest = JSON.parse(bundle.slice(firstLine + 1, bundle.indexOf('\n', firstLine + 1)));
+    const files = Object.keys(manifest.resolutions);
+    assert.ok(files.some(file => file.endsWith('/bare-type/binding.js')));
+    assert.doesNotMatch(JSON.stringify(manifest.resolutions), /bare-(type|performance|abort|stdio)-jsshim/);
+    for (const file of files.filter(file => /bare-(type|performance|abort|stdio)\/binding.js$/.test(file))) {
+      const binding = manifest.resolutions[file]['.'];
+      const moduleName = file.split('/').at(-2);
+      assert.match(binding.android, new RegExp(`^linked:lib${moduleName}\\.\\d+\\.\\d+\\.\\d+\\.so$`));
+      assert.ok(manifest.addons.includes(binding.android), file);
+      assert.ok(manifest.addons.includes(binding.ios), file);
+    }
+  });
+}
